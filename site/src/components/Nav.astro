---
const links = [
  { label: "Work",     href: "#work" },
  { label: "Services", href: "#services" },
  { label: "Process",  href: "#process" },
  { label: "Pricing",  href: "#pricing" },
];
---
<header class="nav">
  <div class="page nav__inner">
    <a class="nav__mark" href="/">Aaron Streets</a>
    <nav class="nav__links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .nav { border-bottom: 1px solid var(--line); background: var(--surface); }
  .nav__inner {
    display: flex; align-items: center; justify-content: space-between;
    padding-block: 22px;
  }
  .nav__mark { font-weight: var(--weight-bold); font-size: 17px;
    letter-spacing: -0.02em; text-decoration: none; }
  .nav__links { display: flex; gap: 26px; }
  .nav__links a {
    font-family: var(--font-mono); font-size: var(--size-label);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--ink-2); text-decoration: none;
  }
  .nav__links a:hover { color: var(--ink); }
  @media (max-width: 620px) { .nav__links { gap: 16px; } }
</style>
